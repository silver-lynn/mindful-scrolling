<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mindful Timer"
    Width="480"
    Height="286"
    MinWidth="420"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="True">
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#F7F3E9" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#EEECE5" />
        <SolidColorBrush x:Key="InkBrush" Color="#20221F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#686D65" />
        <SolidColorBrush x:Key="SageBrush" Color="#456B54" />
        <SolidColorBrush x:Key="PaleSageBrush" Color="#DDE6D8" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDD9CF" />
        <SolidColorBrush x:Key="InputBrush" Color="#FDFCF8" />
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FrameBrush" Color="#E2DED4" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CaretBrush" Value="{DynamicResource SageBrush}" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SageBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource SageBrush}" />
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="22" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow" BlurRadius="28" ShadowDepth="7" Opacity="0.22" Color="#33382F" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="DragBar" Grid.Row="0" Background="Transparent" Margin="16,8,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SageBrush}" Margin="0,0,9,0" />
                    <TextBlock Text="M I N D F U L" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SageBrush}" />
                    <TextBlock x:Name="SaveStatus" Text="" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ThemeButton"
                            Style="{StaticResource WindowButton}"
                            FontFamily="Segoe UI Symbol"
                            FontSize="15"
                            ToolTip="切换到夜间模式">
                        <Grid Width="18" Height="18">
                            <Grid x:Name="MoonIcon" Width="16" Height="16">
                                <Ellipse Width="13" Height="13"
                                         Fill="{DynamicResource MutedBrush}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />
                                <Ellipse Width="11" Height="11"
                                         Fill="{DynamicResource CanvasBrush}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,-1,-1,0" />
                            </Grid>
                            <TextBlock x:Name="SunIcon"
                                       Text="☀"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="16"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Content="—" ToolTip="最小化" />
                    <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="✕" FontSize="17" Width="38" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="22,8,22,22">
                <Grid x:Name="StartPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="这次想带着什么目的开始？" FontSize="21" FontWeight="Medium" />
                        <TextBlock Text="写具体一点。它会一直留在悬浮钟上。" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                    <TextBox x:Name="PurposeInput" Grid.Row="1" Margin="0,18,0,0" MaxLength="120" Height="44" VerticalContentAlignment="Center" />
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="StartLibraryButton" Style="{StaticResource QuietButton}" Content="查看笔记库" Padding="0,8" />
                            <TextBlock x:Name="RestoreHint" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="" Margin="12,0,0,0" />
                        </StackPanel>
                        <Button x:Name="StartButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="开始积累" MinWidth="112" />
                    </Grid>
                </Grid>

                <Grid x:Name="TimerPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ActivePurpose" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <Border Background="{DynamicResource PaleSageBrush}" CornerRadius="7" Padding="7,3" Margin="0,6,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="●  LIVE · 正在积累" FontSize="10" Foreground="{DynamicResource SageBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TimerText" Grid.Column="1" Text="00:00" FontFamily="Consolas" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource SageBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1" Margin="0,14,0,0" Background="{DynamicResource SurfaceBrush}" CornerRadius="15" Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ToggleNotesButton" Style="{StaticResource QuietButton}" Content="展开记事  ↓" />
                            <Button x:Name="OpenRecordsButton" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Content="查看笔记库" Margin="4,0,0,0" />
                            <Button x:Name="FinishButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="结束并留下记录" />
                        </Grid>
                    </Border>

                    <Grid x:Name="NotesPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,16" />
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="边看边记" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="写下值得留下的链接、观察、问题或一句话。内容会自动保存。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,10" />
                            <TextBox x:Name="NotesInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="260" VerticalContentAlignment="Top" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="草稿保存在 data/current-note.md" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" />
                    </Grid>
                </Grid>

                <Grid x:Name="DonePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="✓  这次积累已经留下" FontSize="20" FontWeight="Medium" Foreground="{DynamicResource SageBrush}" />
                        <TextBlock x:Name="DoneSummary" FontSize="14" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock x:Name="DoneMeta" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource PaleSageBrush}" CornerRadius="14" Padding="14" Margin="0,18,0,0">
                        <TextBlock Text="目的、时长和笔记已追加到 records.md。下一次可以从一个新的问题开始。" FontSize="12" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                    </Border>
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DoneOpenButton" Style="{StaticResource QuietButton}" Content="查看笔记库" HorizontalAlignment="Left" />
                        <Button x:Name="NextButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="开始下一次" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
