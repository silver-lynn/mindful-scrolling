<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mindful Notes"
    Width="920"
    Height="640"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="False"
    ShowInTaskbar="True">
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#FBFAF6" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F0EFEA" />
        <SolidColorBrush x:Key="InkBrush" Color="#20231F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7069" />
        <SolidColorBrush x:Key="SageBrush" Color="#42664F" />
        <SolidColorBrush x:Key="PaleSageBrush" Color="#E0EADF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E2E0D8" />
        <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FrameBrush" Color="#DFDED7" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource SageBrush}" />
        </Style>
        <Style x:Key="LibraryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SageBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="LibraryPrimaryButton" TargetType="Button" BasedOn="{StaticResource LibraryButton}">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SageBrush}" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryWindowButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="13" Padding="13,11">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PaleSageBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="LibraryRoot" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1" CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect x:Name="LibraryShadow" BlurRadius="34" ShadowDepth="9" Opacity="0.24" Color="#273024" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="LibraryDragBar" Margin="20,10,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SageBrush}" Margin="0,0,9,0" />
                    <TextBlock Text="M I N D F U L  ·  N O T E S" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SageBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="LibraryThemeButton" Style="{StaticResource LibraryWindowButton}" ToolTip="切换到夜间模式">
                        <Grid Width="18" Height="18">
                            <Grid x:Name="LibraryMoonIcon" Width="16" Height="16">
                                <Ellipse Width="13" Height="13"
                                         Fill="{DynamicResource MutedBrush}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />
                                <Ellipse Width="11" Height="11"
                                         Fill="{DynamicResource CanvasBrush}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,-1,-1,0" />
                            </Grid>
                            <TextBlock x:Name="LibrarySunIcon"
                                       Text="☀"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="16"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="LibraryCloseButton" Style="{StaticResource LibraryWindowButton}" Content="✕" FontSize="17" Width="38" ToolTip="关闭笔记库" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20,8,20,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="292" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="我的积累" FontSize="25" FontWeight="Medium" />
                        <TextBlock Text="从目的回到真正留下的东西。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBox x:Name="LibrarySearchInput" Grid.Row="1" Height="40" Margin="0,17,0,13" Padding="12,7" FontSize="13" VerticalContentAlignment="Center" />
                    <ListBox x:Name="LibraryList" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Purpose}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ListMeta}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LibraryCount" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        <Button x:Name="OpenRawButton" Grid.Column="1" Style="{StaticResource LibraryButton}" Content="打开原始文件" />
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource LineBrush}" />

                <Grid Grid.Column="2" Margin="26,4,0,0">
                    <Grid x:Name="LibraryEmptyPanel">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="330">
                            <TextBlock Text="还没有可以阅读的记录" FontSize="19" FontWeight="Medium" HorizontalAlignment="Center" />
                            <TextBlock Text="完成一次 Session 后，目的、时长和笔记会出现在这里。" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="LibraryDetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Border Background="{DynamicResource PaleSageBrush}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left">
                                <TextBlock x:Name="DetailKind" FontSize="10" Foreground="{DynamicResource SageBrush}" />
                            </Border>
                            <TextBlock x:Name="DetailPurpose" FontSize="24" FontWeight="Medium" TextWrapping="Wrap" Margin="0,14,0,0" />
                            <TextBlock x:Name="DetailMeta" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource LineBrush}" Margin="0,20,0,18" />
                        <TextBox x:Name="DetailNotes" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0" FontSize="15" />
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetailSavedHint" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                            <Border x:Name="CopyNoteButton"
                                    Grid.Column="1"
                                    Width="88"
                                    Height="36"
                                    Background="{DynamicResource SageBrush}"
                                    CornerRadius="11"
                                    Cursor="Hand">
                                <TextBlock x:Name="CopyNoteLabel"
                                           Text="复制全文"
                                           Foreground="{DynamicResource ButtonTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
